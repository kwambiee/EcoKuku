// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= AUTHENTICATION & USERS =============

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
  DRIVER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  password      String
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  avatar        String?
  customerType  String?   // RETAIL, WHOLESALE, RESTAURANT, INDIVIDUAL
  location      String?
  adminNotes    String?
  referralCode  String?   @unique
  referredby    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  batchOrders   BatchOrder[]

  @@index([email])
  @@index([phone])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  area      String   // Nairobi area for delivery fee lookup
  street    String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============= PRODUCTS & INVENTORY =============

model ProductTypeConfig {
  id         String  @id @default(cuid())
  name       String  @unique
  label      String
  category   String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  description    String
  type           String
  category       String
  price          Decimal  @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  unit           String   @default("per unit")
  image          String?
  available      Boolean  @default(true)
  status         String   @default("available") // available, pre_order, out_of_stock
  visibleInStore Boolean  @default(true)
  stock          Int      @default(0)
  reorderLevel   Int      @default(10)
  minOrderQty    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems  OrderItem[]
  reviews     Review[]

  @@index([category])
  @@index([available])
}

// ============= ORDERS & SALES =============

enum OrderType {
  RETAIL
  WHOLESALE
  PREORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String
  orderType         OrderType   @default(RETAIL)
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  deliveryFee       Decimal     @db.Decimal(10, 2)
  promoId           String?
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  paymentMethod     String      @default("MPESA")
  paymentRef        String?     // M-PESA transaction ref
  deliveryArea      String?
  deliveryDate      DateTime?
  deliveryAddress   String?
  notes             String?
  driverId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  customer          User        @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  promo             Promo?      @relation(fields: [promoId], references: [id])
  delivery          Delivery?
  driver            Driver?     @relation(fields: [driverId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ============= PROMOTIONS =============

model Promo {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  discountType String  @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Decimal @db.Decimal(10, 2)
  maxUses    Int?
  uses       Int      @default(0)
  maxPerUser Int      @default(1)
  active      Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  orders      Order[]

  @@index([code])
  @@index([active])
}

// ============= REVIEWS & RATINGS =============

model Review {
  id        String   @id @default(cuid())
  productId String
  customerId String
  rating    Int      @db.SmallInt // 1-5
  comment   String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
}

// ============= LOGISTICS & DELIVERY =============

enum DeliveryStatus {
  SCHEDULED
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Driver {
  id        String  @id @default(cuid())
  name      String
  phone     String  @unique
  vehicle   String
  plate     String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
  orders     Order[]

  @@index([active])
}

model Delivery {
  id            String          @id @default(cuid())
  orderId       String          @unique
  driverId      String?
  status        DeliveryStatus  @default(SCHEDULED)
  scheduledDate DateTime
  actualDate    DateTime?
  location      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver        Driver?         @relation(fields: [driverId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ============= FARM MANAGEMENT: BATCHES =============

enum BatchType {
  BROILER        // Meat chickens
  LAYER          // Egg-laying chickens
  KIENYEJI       // Traditional breed
  MIXED          // Multiple breeds/types in one batch
}

enum BatchStatus {
  ACTIVE
  RESTING
  SOLD_OUT
  CULLED
}

model Batch {
  id            String      @id @default(cuid())
  batchNumber   String      @unique
  type          BatchType
  status        BatchStatus @default(ACTIVE)
  startDate     DateTime
  expectedReady DateTime?   // Expected market-ready date
  quantity      Int         // Number of chicks started
  currentCount  Int         // Current count (after mortality)
  breed         String?
  source        String?     // Origin of chicks (e.g. "Incubation INC-24/06/2026-01" or "Purchased")
  incubationBatchId String? // Set when created via move_to_farm from an IncubationBatch
  supplier      String?     // Supplier name if purchased
  coopAssignment String?    // Coop / house / brooder assigned
  acquisitionCost Decimal?  @db.Decimal(10, 2) // Total purchase/hatching cost
  ageAtArrival    Int       @default(0) // Age in days when chicks arrived
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Booking fields
  isOpenForBooking Boolean    @default(false)
  maxBookings      Int?
  bookedCount      Int        @default(0)
  pricePerChick    Decimal?   @db.Decimal(10, 2)

  // Relations
  mortalityLogs MortalityLog[]
  growthLogs    GrowthLog[]
  vaccinations  Vaccination[]
  expenses      Expense[]
  healthEvents  HealthEvent[]
  eggProduction EggProduction[]
  feedLogs      FeedLog[]
  batchOrders   BatchOrder[]

  @@index([type])
  @@index([status])
  @@index([startDate])
}

model MortalityLog {
  id        String   @id @default(cuid())
  batchId   String
  date      DateTime @default(now())
  count     Int      // Number died
  cause     String?  // Disease, predation, etc.
  notes     String?
  createdAt DateTime @default(now())

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([date])
}

model GrowthLog {
  id        String   @id @default(cuid())
  batchId   String
  date      DateTime @default(now())
  avgWeight Decimal? @db.Decimal(10, 2) // kg
  notes     String?
  createdAt DateTime @default(now())

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([date])
}

// ============= FARM MANAGEMENT: INCUBATION =============

model IncubationBatch {
  id                String    @id @default(cuid())
  batchNumber       String    @unique
  eggCount          Int       // Total eggs loaded
  startDate         DateTime
  expectedHatchDate DateTime
  hatchedCount      Int       @default(0)
  failedCount       Int       @default(0)
  weakChicks        Int       @default(0)
  temperature       Decimal?  @db.Decimal(5, 2) // Starting temperature (Celsius)
  humidity          Decimal?  @db.Decimal(5, 2) // Starting humidity (%)
  eggSource         String?   // OWN_FARM or PURCHASED
  supplier          String?   // Supplier name if purchased
  status            String    @default("INCUBATING") // INCUBATING, HATCHING, COMPLETED, CLOSED
  coopAssignment    String?   // Which coop/house chicks moved to
  transferDate      DateTime? // When moved to farm
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  tempLogs          TemperatureLog[]
  humidityLogs      HumidityLog[]

  @@index([startDate])
  @@index([expectedHatchDate])
  @@index([status])
}

model TemperatureLog {
  id                  String   @id @default(cuid())
  incubationBatchId   String
  timestamp           DateTime @default(now())
  temperature         Decimal  @db.Decimal(5, 2) // Celsius
  notes               String?

  incubationBatch     IncubationBatch @relation(fields: [incubationBatchId], references: [id], onDelete: Cascade)

  @@index([incubationBatchId])
  @@index([timestamp])
}

model HumidityLog {
  id                  String   @id @default(cuid())
  incubationBatchId   String
  timestamp           DateTime @default(now())
  humidity            Decimal  @db.Decimal(5, 2) // Percentage
  notes               String?

  incubationBatch     IncubationBatch @relation(fields: [incubationBatchId], references: [id], onDelete: Cascade)

  @@index([incubationBatchId])
  @@index([timestamp])
}

// ============= FARM MANAGEMENT: EGG PRODUCTION =============

model EggProduction {
  id             String   @id @default(cuid())
  batchId        String?
  date           DateTime @default(now())
  collected      Int      // Number collected
  broken         Int      @default(0)
  cracked        Int      @default(0)
  eggSize        String?  // Small, Medium, Large, Extra Large
  collectionTime String?  // Morning, Afternoon, Evening
  collectedBy    String?  // Staff member name
  storageLocation String? // Where eggs are stored
  notes          String?
  createdAt      DateTime @default(now())

  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([date])
}

// ============= FARM MANAGEMENT: FEED =============

model FeedType {
  id        String   @id @default(cuid())
  name      String   // e.g., "Starter Feed", "Layer Mash"
  supplier  String?
  cost      Decimal? @db.Decimal(10, 2) // per bag/unit
  notes     String?
  createdAt DateTime @default(now())

  stock     FeedStock[]
  purchases FeedPurchase[]
}

model FeedPurchase {
  id              String   @id @default(cuid())
  feedTypeId      String
  date            DateTime @default(now())
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String   @default("kg")
  supplierName    String
  supplierContact String?
  purchasePrice   Decimal  @db.Decimal(10, 2)
  transportCost   Decimal  @default(0) @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(10, 2)
  receiptRef      String?
  notes           String?
  createdAt       DateTime @default(now())

  feedType        FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  @@index([feedTypeId])
  @@index([date])
}

model FeedStock {
  id          String   @id @default(cuid())
  feedTypeId  String
  quantity    Decimal  @db.Decimal(10, 2) // kg or bags
  unit        String   @default("kg") // kg, bags, etc.
  lastUpdated DateTime @default(now())

  feedType    FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  @@index([feedTypeId])
}

model FeedLog {
  id        String   @id @default(cuid())
  batchId   String?
  feedType  String   // e.g., "Layer Mash", "Starter Crumb"
  recordedDate DateTime @default(now())
  quantityUsed Decimal @db.Decimal(10, 2)
  quantityRemaining Decimal? @db.Decimal(10, 2)
  supplier  String?
  notes     String?
  createdAt DateTime @default(now())

  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([recordedDate])
}

// ============= FARM MANAGEMENT: HEALTH & VACCINATION =============

enum VaccinationType {
  NEWCASTLE
  GUMBORO
  FOWLPOX
  MAREK
  COCCIDIOSIS
  OTHER
}

model Vaccination {
  id        String   @id @default(cuid())
  batchId   String?
  vaccineType String  // e.g., "Newcastle", "Gumboro"
  dateAdministered DateTime @default(now())
  dosage    String?   // e.g., "0.5ml per bird"
  administeredBy String? // Staff member name
  batchNo   String?   // Vaccine batch number
  notes     String?
  createdAt DateTime @default(now())

  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([dateAdministered])
}

model VaccinationSchedule {
  id            String          @id @default(cuid())
  batchId       String?         // Null = general schedule template
  type          VaccinationType
  daysOld       Int             // When to vaccinate (days of age)
  completed     Boolean         @default(false)
  completedDate DateTime?
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([daysOld])
}

model HealthEvent {
  id               String   @id @default(cuid())
  batchId          String
  type             String   // "disease", "injury", "treatment", "vet_visit"
  date             DateTime @default(now())
  disease          String?
  symptoms         String?
  diagnosis        String?
  treatment        String?
  dosage           String?
  duration         String?  // e.g. "5 days", "1 week"
  withdrawalPeriod Int?     // days — meat/egg withdrawal after treatment
  withdrawalEnds   DateTime?
  outcome          String?  // RECOVERING, RECOVERED, MORTALITY, ONGOING
  vetName          String?
  cost             Decimal? @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([date])
}

// ============= EXPENSES / EXPENDITURE TRACKING =============

enum ExpenseCategory {
  FEED
  MEDICINE_VACCINE
  CHICKS_PURCHASE
  PACKAGING
  EQUIPMENT
  LABOUR
  UTILITIES
  TRANSPORT
  VETERINARY
  OTHER
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  month     Int      // 1–12
  year      Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([year])
}

model Expense {
  id             String          @id @default(cuid())
  date           DateTime        @default(now())
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(10, 2)
  paymentMethod  String?         // CASH, MPESA, BANK_TRANSFER
  vendor         String?
  receiptRef     String?
  receiptImage   String?         // URL of uploaded receipt photo
  notes          String?
  sourceType     String?         // FEED_PURCHASE, BATCH_CREATION, VACCINATION, MANUAL
  sourceId       String?         // ID of the source record
  batchId        String?         // Optional link to a specific batch
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  batch          Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([date])
  @@index([batchId])
}

// ============= BATCH ORDERS (CUSTOMER PRE-ORDERS FOR REARING) =============

enum BatchOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  GROWING
  READY
  COMPLETED
  CANCELLED
}

model BatchOrder {
  id                String           @id @default(cuid())
  orderNumber       String           @unique
  customerId        String
  batchId           String
  quantity          Int
  pricePerChick     Decimal          @db.Decimal(10, 2)
  totalPrice        Decimal          @db.Decimal(10, 2)
  depositAmount     Decimal          @db.Decimal(10, 2)
  depositPaid       Boolean          @default(false)
  depositPaymentRef String?
  status            BatchOrderStatus @default(PENDING_PAYMENT)
  expectedReadyDate DateTime?
  deliveryArea      String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer          User             @relation(fields: [customerId], references: [id])
  batch             Batch            @relation(fields: [batchId], references: [id])
  updates           BatchOrderUpdate[]

  @@index([customerId])
  @@index([batchId])
  @@index([status])
}

model BatchOrderUpdate {
  id           String     @id @default(cuid())
  batchOrderId String
  title        String
  message      String
  type         String     @default("UPDATE")
  createdAt    DateTime   @default(now())

  batchOrder   BatchOrder @relation(fields: [batchOrderId], references: [id], onDelete: Cascade)

  @@index([batchOrderId])
  @@index([createdAt])
}

// ============= SETTINGS & CONFIGURATION =============

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userEmail String
  action    String
  module    String
  recordId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json

  @@index([key])
}

model Goal {
  id        String   @id @default(cuid())
  type      String   // WEEKLY, MONTHLY, YEARLY
  category  String   // EGG_PRODUCTION, REVENUE, ORDERS, CHICK_COUNT, MORTALITY_RATE, FEED_USAGE, EXPENSES
  target    Decimal  @db.Decimal(12, 2)
  period    String   // "2026-W29" | "2026-07" | "2026"
  label     String?  // Optional custom label
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, period])
  @@index([type, period])
}

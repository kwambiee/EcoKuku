# EcoKuku Local Development Environment

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecokuku_dev"

# NextAuth Configuration
NEXTAUTH_SECRET="your-super-secret-key-here-min-32-characters-required"
NEXTAUTH_URL="http://localhost:3000"

# Admin NextAuth
NEXTAUTH_SECRET_ADMIN="another-super-secret-key-here-min-32-characters"
NEXTAUTH_URL_ADMIN="http://localhost:3001"

# M-PESA / Daraja API (Get from https://developer.safaricom.co.ke/)
MPESA_CONSUMER_KEY="your_consumer_key_here"
MPESA_CONSUMER_SECRET="your_consumer_secret_here"
MPESA_BUSINESS_SHORT_CODE="123456"
MPESA_PASSKEY="your_passkey_here"
MPESA_TEST_PHONE="254712345678"
MPESA_ENVIRONMENT="sandbox"

# Africa's Talking SMS API (Get from https://africastalking.com/)
AFRICAS_TALKING_API_KEY="your_africas_talking_api_key"
AFRICAS_TALKING_USERNAME="your_at_username"
AFRICAS_TALKING_ENV="sandbox"

# Email Configuration (Gmail example, or use your own SMTP)
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"

# Or use custom SMTP server
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT="587"
# EMAIL_SECURE="false"
# EMAIL_USER="username@example.com"
# EMAIL_PASS="password"

# Environment
NODE_ENV="development"
PORT_WEB="3000"
PORT_ADMIN="3001"
LOG_LEVEL="debug"

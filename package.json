{
  "name": "kwamboka-poultry",
  "version": "0.1.0",
  "private": true,
  "description": "Kwamboka Poultry Farm Management Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:push": "turbo run db:push --scope=@ecokuku/db",
    "db:studio": "turbo run db:studio --scope=@ecokuku/db",
    "db:seed": "turbo run db:seed --scope=@ecokuku/db",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.2.0"
  },
  "keywords": [
    "poultry",
    "farm",
    "management",
    "ecommerce",
    "dashboard"
  ],
  "author": "Kwamboka Poultry Team"
}
